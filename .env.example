# Template for .env. Copy it to .env and fill in real values there.
# .env is git-ignored and never committed; this file holds names and placeholders only.
# Every variable is optional. An empty value means "use the default".

# Where SYNTHIA keeps its data: databases, downloaded models, caches, logs.
# Default: the platform's user data directory, for example
# %LOCALAPPDATA%\synthia on Windows or ~/.local/share/synthia on Linux.
SYNTHIA_HOME=

# DEBUG, INFO, WARNING or ERROR. Default: INFO.
SYNTHIA_LOG_LEVEL=

# console (readable) or json (one object per line). Default: console.
SYNTHIA_LOG_FORMAT=

# Disk space SYNTHIA may use under SYNTHIA_HOME, in gigabytes. Default: 10.
SYNTHIA_DISK_BUDGET_GB=

# OpenRouter API key from https://openrouter.ai/keys. Default: unset, remote models off.
SYNTHIA_OPENROUTER_API_KEY=

# The remote provider: openrouter (built in) or the name of a [providers.<name>] table in
# SYNTHIA_HOME/providers.toml. A chat uses it only after `/remote on`,
# `synthia chat --remote` or SYNTHIA_BRAIN=remote; otherwise every turn stays local.
# Default: openrouter.
SYNTHIA_REMOTE=

# Where a chat starts: local, or remote to start every chat as `--remote` does. A turn
# still goes out only with your consent for that provider: asked when nothing is saved,
# and after a no the chat starts local. `synthia chat --no-remote` keeps one chat
# local. Default: local.
SYNTHIA_BRAIN=

# Each provider's key has its own variable, SYNTHIA_<NAME>_API_KEY, where NAME is the
# provider's name in capitals with - as _: SYNTHIA_OPENAI_API_KEY for [providers.openai],
# SYNTHIA_MY_LOCAL_API_KEY for [providers.my-local]. Add the line for each provider you
# use. A key goes only to its own provider, and is masked in logs like the settings above.
# Instead of a line here, `synthia keys set <provider>` keeps the key in the system key
# store (Windows Credential Manager, the macOS Keychain, the Secret Service on Linux), and a
# stored key wins over the line here.

# Persona to start in: a built-in (synthia, nova, horizon, zenith, neon, glacier,
# starlight, minato, yume) or a .toml file in SYNTHIA_HOME/personas. Default: synthia.
SYNTHIA_PERSONA=

# Local model, from `synthia models list`. Default: qwen3.5-4b.
SYNTHIA_LOCAL_MODEL=

# What the local model runs on: auto, cpu, vulkan, cuda or metal. Default: auto, which
# tries the fastest installed build first and falls back to the next if it fails to start.
SYNTHIA_LOCAL_BACKEND=

# Folders SYNTHIA's file tools may read, separated like PATH (; on Windows, : on Linux).
# A relative path asked for is taken from the first. Default: none, so files are never read.
SYNTHIA_FILE_ROOTS=
